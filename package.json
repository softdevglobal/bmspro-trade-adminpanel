{
  "name": "bmspro-trade-adminpanel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:super-admin": "tsx --env-file=.env.local scripts/seed-super-admin.ts",
    "cron:reminders": "tsx --env-file=.env scripts/run-schedule-reminders.ts",
    "migrate:renumber-codes": "tsx --env-file=.env scripts/renumber-reference-codes.ts",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,storage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bms-security-test \"node scripts/test-firestore-rules.mjs\"",
    "test:api": "firebase emulators:exec --only auth,firestore --project bms-api-test \"node scripts/test-api-access.mjs\"",
    "test:careplus-records": "tsx --test scripts/test-careplus-capture-records.ts",
    "test:invoice-customer": "tsx --test scripts/test-invoice-customer.ts",
    "test:email-integration": "tsx --import ./scripts/stub-server-only.mjs --test scripts/test-email-integration.ts",
    "test:ai-staff-assignment": "tsx --test scripts/test-ai-staff-assignment.ts",
    "test:booking-auth": "tsx --import ./scripts/stub-server-only.mjs --test scripts/test-call-center-bookings.ts",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "test:security": "firebase emulators:exec --only auth,firestore,storage --project demo-bms-security-test \"node scripts/test-security.mjs\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "imapflow": "2.2.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mailparser": "3.9.36",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.3",
    "zeptomail": "^8.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^14.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
