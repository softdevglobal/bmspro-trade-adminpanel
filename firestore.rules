rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.get("role", "") != "pending_owner";
    }

    function hasAccountAccess() {
      return isSignedIn()
        && businessAccessIfPresent(request.auth.token.get('businessId', ''))
        && accountReady("users") && accountReady("customers");
    }

    // Keep these checks aligned with lib/auth/account-access.ts. The database
    // state is checked even when a client still holds a previously issued token.
    function businessAccessible(businessId) {
      let path = /databases/$(database)/documents/businesses/$(businessId);
      return businessId is string && businessId != '' && exists(path)
        && get(path).data.get('isActive', true) != false
        && get(path).data.get('status', '') != 'suspended';
    }

    function businessAccessIfPresent(businessId) {
      return businessId == '' || businessId == null || businessAccessible(businessId);
    }

    function profileReady(data) {
      return data.get('activationRequired', false) == false
        && data.get('mustChangePassword', false) == false
        && data.get('emailVerificationRequired', false) == false
        && data.get('disabled', false) != true
        && data.get('suspended', false) != true
        && data.get('isActive', true) != false
        && !(data.get('status', '') in ['inactive', 'disabled', 'suspended'])
        && businessAccessIfPresent(data.get('businessId', ''))
        && businessAccessIfPresent(data.get('registeredBusinessId', ''));
    }

    function recordBusinessAccessible() {
      return businessAccessible(resource.data.get('businessId', ''));
    }

    function accountReady(collection) {
      let path = /databases/$(database)/documents/$(collection)/$(request.auth.uid);
      return !exists(path) || profileReady(get(path).data);
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.superAdmin == true
          || request.auth.token.role == 'super_admin'
        );
    }

    function isBusinessOwner() {
      return isSignedIn()
        && request.auth.token.businessId is string
        && (
          request.auth.token.role == 'owner'
          || request.auth.token.role == 'admin'
        );
    }

    function signedInUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userIsOwnerRole() {
      return signedInUserDocExists()
        && userDocData().role in [
          'owner',
          'admin',
          'business_owner',
          'salon_owner'
        ];
    }

    function userOwnsBusiness(businessId) {
      return userIsOwnerRole()
        && userDocData().businessId == businessId;
    }

    function ownsBusiness(businessId) {
      return isBusinessOwner() && request.auth.token.businessId == businessId;
    }

    function belongsToBusiness(businessId) {
      return ownsBusiness(businessId)
        || userOwnsBusiness(businessId)
        || (isBusinessStaff() && request.auth.token.businessId == businessId)
        || (
          signedInUserDocExists()
          && userDocData().businessId == businessId
          && userDocData().role in ['staff', 'salon_staff']
        );
    }

    // Login gate: each user may read only their own super_admins document.
    match /super_admins/{uid} {
      allow read: if hasAccountAccess() && (isSignedIn() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    // Business owners read their workspace; super admins read all.
    match /businesses/{businessId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (businessAccessible(businessId) && (
          ownsBusiness(businessId)
          || userOwnsBusiness(businessId)
          || (signedInUserDocExists() && resource.data.ownerUid == request.auth.uid)
        )));
      allow create, update, delete: if false;
    }

    function isBusinessStaff() {
      return isSignedIn()
        && request.auth.token.businessId is string
        && request.auth.token.role == 'staff';
    }

    function ownsStaffInspection() {
      return isBusinessStaff()
        && resource.data.businessId == request.auth.token.businessId
        && resource.data.assignedTo is map
        && resource.data.assignedTo.uid == request.auth.uid;
    }

    function userFcmFieldKeys() {
      return ['fcmToken', 'fcmTokenUpdatedAt', 'platform', 'deviceInfo'];
    }

    function userSelfFcmWrite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(userFcmFieldKeys());
    }

    // Profile details a signed-in user may change on their own user document
    // (the mobile app's Edit Profile). Role, business, status and activation
    // fields stay server-only.
    function userProfileFieldKeys() {
      return ['displayName', 'name', 'phone', 'contactPhone', 'updatedAt'];
    }

    function ownerProfileFieldKeys() {
      return ['abn', 'locationText', 'address', 'logoUrl'];
    }

    function isTextUpTo(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function userSelfProfileWrite(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      let isOwner = resource.data.get('role', '') in
        ['owner', 'admin', 'business_owner', 'salon_owner'];
      let allowed = isOwner
        ? userProfileFieldKeys().concat(ownerProfileFieldKeys()).concat(userFcmFieldKeys())
        : userProfileFieldKeys().concat(userFcmFieldKeys());
      return isSignedIn()
        && request.auth.uid == userId
        && changed.hasOnly(allowed)
        && (!changed.hasAny(['name']) || (isTextUpTo(next.name, 80) && next.name.size() > 0))
        && (!changed.hasAny(['displayName']) || isTextUpTo(next.displayName, 80))
        && (!changed.hasAny(['phone']) || isTextUpTo(next.phone, 30))
        && (!changed.hasAny(['contactPhone']) || isTextUpTo(next.contactPhone, 30))
        && (!changed.hasAny(['updatedAt']) || next.updatedAt == request.time)
        && (!changed.hasAny(['abn']) || isTextUpTo(next.abn, 20))
        && (!changed.hasAny(['locationText']) || isTextUpTo(next.locationText, 300))
        && (!changed.hasAny(['address']) || isTextUpTo(next.address, 300))
        && (!changed.hasAny(['logoUrl'])
            || (isTextUpTo(next.logoUrl, 2000) && next.logoUrl.matches('https://.*')));
    }

    function userSelfFcmCreate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(userFcmFieldKeys());
    }

    function salonStaffSelfFcmWrite(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmToken', 'fcmTokenUpdatedAt', 'platform']);
    }

    function ownsLegacyNotification() {
      return isSignedIn()
        && (
          resource.data.staffUid == request.auth.uid
          || resource.data.ownerUid == request.auth.uid
          || resource.data.branchAdminUid == request.auth.uid
          || resource.data.customerUid == request.auth.uid
          || resource.data.targetAdminUid == request.auth.uid
        );
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if hasAccountAccess() && (userSelfFcmCreate(uid));
      allow update: if hasAccountAccess() && (userSelfFcmWrite(uid) || userSelfProfileWrite(uid));
      allow delete: if false;
    }

    // Legacy salon staff profiles (FCM token + self read).
    match /salon_staff/{uid} {
      allow read: if hasAccountAccess() && (isSignedIn() && request.auth.uid == uid);
      allow update: if hasAccountAccess() && (salonStaffSelfFcmWrite(uid));
      allow create, delete: if false;
    }

    // Legacy in-app notifications (salon + trade mobile).
    match /notifications/{notificationId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || ownsLegacyNotification());
      allow update: if hasAccountAccess() && (isSuperAdmin()
        || (ownsLegacyNotification() && notificationReadOnlyUpdate()));
      allow create, delete: if false;
    }

    function belongsToActiveBusiness(businessId) {
      return belongsToBusiness(businessId)
        && businessAccessible(businessId);
    }

    // Staff attendance / GPS check-ins (mobile background location).
    match /staff_check_ins/{checkInId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isSignedIn() && recordBusinessAccessible() && resource.data.staffId == request.auth.uid));
      // Attendance is recorded by the API with server identity and timestamps.
      allow create, update: if false;
      allow delete: if false;
    }

    // Booking intake attempts: write-only audit log from server; admins/owners read.
    match /booking_intake_attempts/{attemptId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isBusinessOwner()
            && resource.data.businessId == request.auth.token.businessId));
      allow create, update, delete: if false;
    }

    match /service_templates/{templateId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || (isBusinessOwner() && resource.data.isActive == true));
      allow create, update, delete: if false;
    }

    match /services/{serviceId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || belongsToActiveBusiness(resource.data.businessId));
      allow create, update, delete: if false;
    }

    function ownsBusinessNotification() {
      return (isBusinessOwner()
          && resource.data.businessId == request.auth.token.businessId)
        || userOwnsBusiness(resource.data.businessId);
    }

    function notificationReadOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /business_notifications/{notificationId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || ownsBusinessNotification());
      allow update: if hasAccountAccess() && (isSuperAdmin()
        || (ownsBusinessNotification() && notificationReadOnlyUpdate()));
      allow delete: if hasAccountAccess() && (isSuperAdmin() || ownsBusinessNotification());
      allow create: if false;
    }

    // Identity is the uid, never the token email. An account's email is set by
    // whoever provisions it — a business owner can create a staff login with any
    // address, including a customer's — and no account in this project is email
    // verified, so matching a document's email field against the token would let
    // one tenant read another tenant's customer records. Customers reach their
    // own data through /api/customer/*, which resolves the email server-side
    // from an authenticated profile.
    function ownsCustomerNotification() {
      return isSignedIn() && recordBusinessAccessible()
        && resource.data.customerId == request.auth.uid;
    }

    match /customer_notifications/{notificationId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || ownsCustomerNotification());
      allow update: if hasAccountAccess() && (isSuperAdmin()
        || (ownsCustomerNotification() && notificationReadOnlyUpdate()));
      allow delete: if hasAccountAccess() && (isSuperAdmin() || ownsCustomerNotification());
      allow create: if false;
    }

    /** uid only — see the note on ownsCustomerNotification. */
    function ownsCustomerInspection() {
      return isSignedIn() && recordBusinessAccessible()
        && resource.data.customerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isBusinessOwner()
            && resource.data.businessId == request.auth.token.businessId)
        || userOwnsBusiness(resource.data.businessId)
        || ownsStaffInspection()
        || ownsCustomerInspection());
      allow create, update, delete: if false;
    }

    function ownsStaffBooking() {
      return isBusinessStaff()
        && resource.data.businessId == request.auth.token.businessId
        && resource.data.assignedTo is map
        && resource.data.assignedTo.uid == request.auth.uid;
    }

    function ownsAssignedTradeBooking() {
      return isSignedIn() && recordBusinessAccessible()
        && resource.data.assignedTo is map
        && resource.data.assignedTo.uid == request.auth.uid;
    }

    /** uid only — see the note on ownsCustomerNotification. */
    function ownsCustomerBooking() {
      return isSignedIn() && recordBusinessAccessible()
        && resource.data.customerId == request.auth.uid;
    }

    function ownsOwnerUidJob() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid
        && (('businessId' in resource.data)
          ? recordBusinessAccessible()
          : (signedInUserDocExists() && businessAccessible(userDocData().get('businessId', ''))));
    }

    function ownsOwnerUidBookingRequest() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid
        && (('businessId' in resource.data)
          ? recordBusinessAccessible()
          : (signedInUserDocExists() && businessAccessible(userDocData().get('businessId', ''))));
    }

    function canReadBusinessJob() {
      return recordBusinessAccessible()
        && (
          (isBusinessOwner()
              && resource.data.businessId == request.auth.token.businessId)
          || userOwnsBusiness(resource.data.businessId)
          || (isBusinessStaff()
              && resource.data.businessId == request.auth.token.businessId)
          || ownsStaffBooking()
          || ownsAssignedTradeBooking()
          || ownsCustomerBooking()
        );
    }

    // Trade jobs (businessId) + owner-scoped jobs (ownerUid).
    match /jobs/{jobId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || ownsOwnerUidJob()
        || canReadBusinessJob());
      allow create, update, delete: if false;
    }

    // Legacy booking-engine intake (salon / ownerUid-scoped).
    match /bookingRequests/{requestId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || ownsOwnerUidBookingRequest()
        || canReadBusinessJob());
      allow create, update, delete: if false;
    }

    match /quotations/{quotationId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isBusinessOwner()
            && resource.data.businessId == request.auth.token.businessId)
        || userOwnsBusiness(resource.data.businessId));
      allow create, update, delete: if false;
    }

    function canReadBusinessInvoice() {
      return recordBusinessAccessible()
        && (
          (isBusinessOwner()
              && resource.data.businessId == request.auth.token.businessId)
          || userOwnsBusiness(resource.data.businessId)
          || (isBusinessStaff()
              && resource.data.businessId == request.auth.token.businessId)
        );
    }

    match /invoices/{invoiceId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || canReadBusinessInvoice());
      allow create, update, delete: if false;
    }

    // Invoice/quotation number claims — Admin SDK only.
    match /document_counters/{id} {
      allow read, write: if false;
    }

    function canReadBusinessItem() {
      return recordBusinessAccessible()
        && (
          (isBusinessOwner()
              && resource.data.businessId == request.auth.token.businessId)
          || userOwnsBusiness(resource.data.businessId)
          || (isBusinessStaff()
              && resource.data.businessId == request.auth.token.businessId)
        );
    }

    match /items/{itemId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || canReadBusinessItem());
      allow create, update, delete: if false;
    }

    function isCallCenterAgent() {
      return isSignedIn() && request.auth.token.role == 'call_center'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDocData().get('isActive', true) == true
        && !(userDocData().get('status', 'active') in ['inactive', 'disabled', 'suspended'])
        && (!exists(/databases/$(database)/documents/call_center_agents/$(request.auth.uid))
          || (get(/databases/$(database)/documents/call_center_agents/$(request.auth.uid)).data.get('isActive', true) == true
              && !(get(/databases/$(database)/documents/call_center_agents/$(request.auth.uid)).data.get('status', 'active') in ['inactive', 'disabled', 'suspended'])));
    }

    match /conversations/{conversationId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || isCallCenterAgent()
        || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if hasAccountAccess() && (isSuperAdmin()
          || isCallCenterAgent()
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId
              == request.auth.uid
          ));
        allow create, update, delete: if false;
      }
    }

    function ownsCcDirectChat() {
      return isSignedIn()
        && (
          request.auth.uid in resource.data.participantIds
          || resource.data.tenantUserUid == request.auth.uid
        );
    }

    match /cc_direct_chats/{chatId} {
      allow read: if hasAccountAccess() && (isSuperAdmin() || ownsCcDirectChat());
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if hasAccountAccess() && (isSuperAdmin()
          || (
            isSignedIn()
            && (
              request.auth.uid in get(/databases/$(database)/documents/cc_direct_chats/$(chatId)).data.participantIds
              || get(/databases/$(database)/documents/cc_direct_chats/$(chatId)).data.tenantUserUid
                  == request.auth.uid
            )
          ));
        allow create, update, delete: if false;
      }
    }

    match /call_center_agents/{uid} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid));
      allow create, update, delete: if false;
    }

    // Subscription plan catalog — public read for onboarding; writes via Admin SDK.
    match /subscription_plans/{planId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // SMS package catalog — public read for onboarding; writes via Admin SDK.
    match /sms_packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // SMS delivery audit log — written via Admin SDK when messages are sent.
    match /sms_logs/{logId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || userOwnsBusiness(resource.data.businessId));
      allow create, update, delete: if false;
    }

    // Staff time-off / leave requests. Staff create their own (pending); owners
    // and the requester read; approvals/rejections happen via the Admin SDK.
    match /leaveRequests/{leaveId} {
      allow read: if hasAccountAccess() && (isSuperAdmin()
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid)
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (isBusinessOwner()
            && resource.data.businessId == request.auth.token.businessId)
        || userOwnsBusiness(resource.data.businessId));
      // businessId is optional because legacy salon staff documents predate it,
      // but when present it must be the requester's own business — otherwise a
      // staff member can file a request into another tenant's approval queue.
      allow create: if hasAccountAccess() && (isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (
          !('businessId' in request.resource.data)
          || belongsToActiveBusiness(request.resource.data.businessId)
        ));
      allow update, delete: if false;
    }

    function isCareplusCollection() {
      return request.path[3] in [
        'careplus_integrations',
        'careplus_staff_mappings',
        'careplus_customer_mappings',
        'careplus_outbox'
      ];
    }

    // Business-mailbox sending: credentials, queued emails and audit events are
    // only ever touched by the server (Admin SDK), never by any client.
    function isEmailIntegrationCollection() {
      return request.path[3] in [
        'email_connections',
        'email_connection_credentials',
        'email_outbox',
        'email_events',
        'email_oauth_states',
        'email_messages',
        'email_sync_state'
      ];
    }

    function isAdminSdkOnlyCollection() {
      return isCareplusCollection()
        || isEmailIntegrationCollection()
        || request.path[3] in ['document_counters', 'participant_onboarding', 'account_activations', 'security_rate_limits', 'payment_checkout_sessions', 'payment_checkout_targets', 'payment_receipts', 'attendance_sessions', 'aiAssignmentGuards'];
    }

    // Super admins can access remaining collections in the admin portal.
    match /{document=**} {
      allow read, write: if isSuperAdmin() && !isAdminSdkOnlyCollection() && hasAccountAccess();
    }
  }
}
